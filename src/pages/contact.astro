---
import Layout from "../layouts/Layout.astro";
---

<Layout title="contact — gericapo98" current="contact">
  <div>
    <span class="prompt">gericapo98@site:~$</span> <span class="out">cat contact.txt</span>
  </div>
  <div>
    <span class="muted">github</span> <span class="out">→</span> <a class="out accent-on-hover" href="https://github.com/gericapo98">https://github.com/gericapo98</a>
  </div>
  <div>
    <span class="muted">resume</span> <span class="out">→</span> <a class="out accent-on-hover" href="/resume.pdf">/resume.pdf</a>
  </div>
</Layout>

<style>
  .accent-on-hover {
    color: var(--muted);
    text-decoration: none;
  }

  .accent-on-hover:hover,
  .accent-on-hover:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
